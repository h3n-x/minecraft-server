# =============================================================================
# KOMOREBI SMP — temporizador de copias de seguridad
# Managed by KOMOREBI SMP installer v@@INSTALLER_VERSION@@
#
# Persistent=true: si el equipo estaba apagado a la hora prevista, la copia se
# hace al arrancar. La copia semanal se promueve desde la diaria del día
# BACKUP_WEEKLY_DAY (ver /etc/komorebi/komorebi.conf).
# =============================================================================
[Unit]
Description=KOMOREBI SMP - temporizador de copias de seguridad

[Timer]
OnCalendar=@@BACKUP_ONCALENDAR@@
RandomizedDelaySec=10min
Persistent=true
Unit=@@BACKUP_SERVICE_UNIT@@

[Install]
WantedBy=timers.target
